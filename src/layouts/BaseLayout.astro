---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import GridBackground from '../components/GridBackground.astro';
import NoiseOverlay from '../components/NoiseOverlay.astro';
import CustomCursor from '../components/CustomCursor.astro';

export interface Props {
  title?: string;
}

const { title = 'Orbit-dev' } = Astro.props;
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Orbit-dev — скинмейкер, дизайнер и разработчик. Создаю персонажей, интерфейсы и цифровые инструменты." />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Скинмейкер, дизайнер и разработчик. Создаю персонажи, интерфейсы и цифровые инструменты." />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" as="style" />
    <ClientRouter />
  </head>
  <body>
    <CustomCursor />
    <GridBackground />
    <NoiseOverlay />
    <Sidebar transition:persist />
    <main class="main">
      <slot />
    </main>
  </body>
</html>

<style>
  .main {
    margin-left: 80px;
  }

  @media (max-width: 768px) {
    .main {
      margin-left: 0;
    }
  }
</style>
