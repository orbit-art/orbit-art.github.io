---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import GridBackground from '../components/GridBackground.astro';
import NoiseOverlay from '../components/NoiseOverlay.astro';
import CustomCursor from '../components/CustomCursor.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
}

const { title = 'Orbit-dev' } = Astro.props;
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Orbit-dev — скинмейкер, дизайнер и разработчик. Создаю персонажей, интерфейсы и цифровые инструменты." />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Скинмейкер, дизайнер и разработчик. Создаю персонажи, интерфейсы и цифровые инструменты." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/render-og.webp" />
    <meta property="og:url" content="https://orbit-art.github.io" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="Скинмейкер, дизайнер и разработчик." />
    <meta name="twitter:image" content="/images/render-og.webp" />
    <link rel="canonical" href="https://orbit-art.github.io" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" as="style" />
  </head>
  <body>
    <CustomCursor />
    <GridBackground />
    <NoiseOverlay />
    <Sidebar />
    <main class="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function() {
        var isTouch = !window.matchMedia('(hover: hover)').matches;
        var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (!prefersReduced) {
          var revealObserver = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              entry.target.classList.toggle('revealed', entry.isIntersecting);
            });
          }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

          function initReveal() {
            document.querySelectorAll('.scroll-reveal').forEach(function(el) {
              revealObserver.observe(el);
            });
          }
          initReveal();
          document.addEventListener('astro:page-load', initReveal);
        }

        if (isTouch || prefersReduced) return;

        var canvas = null;
        var ctx = null;
        var pen = null;
        var W = 0, H = 0, dpr = 1;
        var mx = -200, my = -200, pmx = -200, pmy = -200;
        var speed = 0, hovering = false, clickBurst = 0, mouseOnPage = true;
        var rafId = 0;
        var particles = [];
        var MAX_PARTICLES = 80;
        var selectors = 'a, button, .glass-card, .btn, .tag, .project-card, .sidebar__link, .hero__render-wrap, [data-cursor-pointer]';

        function resizeCanvas() {
          if (!canvas || !ctx) return;
          W = window.innerWidth;
          H = window.innerHeight;
          canvas.width = W * dpr;
          canvas.height = H * dpr;
          canvas.style.width = W + 'px';
          canvas.style.height = H + 'px';
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }

        function init() {
          canvas = document.querySelector('.cursor-canvas');
          pen = document.querySelector('.cursor-pen');
          if (!canvas || !pen) return false;
          ctx = canvas.getContext('2d');
          if (!ctx) return false;
          dpr = Math.min(window.devicePixelRatio || 1, 2);
          resizeCanvas();
          document.documentElement.style.cursor = 'none';
          mx = -200; my = -200; pmx = -200; pmy = -200;
          particles = [];
          return true;
        }

        function spawnTrail(x, y, count) {
          for (var i = 0; i < count; i++) {
            if (particles.length >= MAX_PARTICLES) particles.shift();
            var angle = Math.random() * Math.PI * 2;
            var v = Math.random() * 1.5 + 0.3;
            particles.push({
              x: x + (Math.random() - 0.5) * 6,
              y: y + (Math.random() - 0.5) * 6,
              vx: Math.cos(angle) * v,
              vy: Math.sin(angle) * v,
              life: 1,
              maxLife: 30 + Math.random() * 40,
              size: Math.random() * 3 + 1.5,
              rot: Math.random() * Math.PI * 2,
              hue: 20 + Math.random() * 20
            });
          }
        }

        function spawnBurst(x, y) {
          for (var i = 0; i < 18; i++) {
            if (particles.length >= MAX_PARTICLES) particles.shift();
            var angle = (i / 18) * Math.PI * 2 + (Math.random() - 0.5) * 0.5;
            var v = Math.random() * 6 + 2;
            particles.push({
              x: x, y: y,
              vx: Math.cos(angle) * v,
              vy: Math.sin(angle) * v,
              life: 1,
              maxLife: 25 + Math.random() * 20,
              size: Math.random() * 4 + 2,
              rot: Math.random() * Math.PI * 2,
              hue: Math.random() > 0.5 ? 25 : 45
            });
          }
        }

        document.addEventListener('mousemove', function(e) {
          mx = e.clientX;
          my = e.clientY;
          if (!mouseOnPage) {
            mouseOnPage = true;
            if (pen) pen.style.opacity = '1';
            if (canvas) canvas.style.opacity = '1';
          }
        });
        document.addEventListener('mousedown', function() { clickBurst = 1; });
        document.addEventListener('mouseover', function(e) {
          if (pen && e.target.closest(selectors)) {
            hovering = true;
            pen.classList.add('cursor-pen--hover');
          }
        });
        document.addEventListener('mouseout', function(e) {
          if (pen && e.target.closest(selectors)) {
            hovering = false;
            pen.classList.remove('cursor-pen--hover');
          }
        });
        document.addEventListener('mouseleave', function() {
          mouseOnPage = false;
          if (pen) pen.style.opacity = '0';
          if (canvas) canvas.style.opacity = '0';
        });
        document.addEventListener('mouseenter', function() {
          mouseOnPage = true;
          if (pen) pen.style.opacity = '1';
          if (canvas) canvas.style.opacity = '1';
        });
        window.addEventListener('resize', resizeCanvas);

        function update() {
          if (!canvas || !pen || !ctx) {
            return;
          }

          var dx = mx - pmx;
          var dy = my - pmy;
          speed = Math.sqrt(dx * dx + dy * dy);
          pmx += (mx - pmx) * 0.25;
          pmy += (my - pmy) * 0.25;

          var angle = Math.atan2(my - pmy, mx - pmx);
          var tilt = Math.min(speed * 0.3, 15);

          pen.style.transform = 'translate(' + mx + 'px, ' + my + 'px) rotate(' + (angle + Math.PI / 4) + 'deg) translate(-50%, -50%) skewX(' + (-tilt) + 'deg)';

          if (speed > 2 && mouseOnPage) {
            spawnTrail(pmx, pmy, speed > 10 ? 2 : 1);
          }

          if (clickBurst > 0) {
            spawnBurst(mx, my);
            clickBurst = 0;
          }

          ctx.clearRect(0, 0, W, H);

          for (var i = particles.length - 1; i >= 0; i--) {
            var p = particles[i];
            p.x += p.vx;
            p.y += p.vy;
            p.vx *= 0.96;
            p.vy *= 0.96;
            p.vy += 0.02;
            p.rot += 0.05;
            p.life -= 1 / p.maxLife;

            if (p.life <= 0) {
              particles.splice(i, 1);
              continue;
            }

            var alpha = p.life * 0.7;
            var s = p.size * (0.5 + p.life * 0.5);

            ctx.save();
            ctx.translate(p.x, p.y);
            ctx.rotate(p.rot);
            ctx.globalAlpha = alpha;

            if (p.size > 3) {
              ctx.beginPath();
              ctx.ellipse(0, 0, s, s * 0.6, 0, 0, Math.PI * 2);
              ctx.fillStyle = 'hsl(' + p.hue + ', 90%, 55%)';
              ctx.fill();
            } else {
              ctx.fillStyle = 'hsl(' + p.hue + ', 85%, 60%)';
              ctx.fillRect(-s / 2, -s / 2, s, s);
            }

            ctx.restore();
          }

          rafId = requestAnimationFrame(update);
        }

        if (init()) {
          rafId = requestAnimationFrame(update);
        }

        document.addEventListener('astro:page-load', function() {
          document.documentElement.style.cursor = 'none';
          if (!canvas || !canvas.isConnected) {
            init();
          }
        });
      })();
    </script>
  </body>
</html>

<style>
  .main {
    margin-left: 80px;
  }

  @media (max-width: 768px) {
    .main {
      margin-left: 0;
      padding-bottom: 80px;
    }
  }
</style>
