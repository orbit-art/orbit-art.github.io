---
import BaseLayout from '../layouts/BaseLayout.astro';

const contacts = [
  {
    name: 'Telegram',
    handle: '@orbitdev',
    url: 'https://t.me/orbitdev',
    desc: 'Быстрая связь и новости',
    copy: '@orbitdev',
  },
  {
    name: 'GitHub',
    handle: '/orbitdev',
    url: 'https://github.com/orbitdev',
    desc: 'Код и Open Source',
    copy: 'github.com/orbitdev',
  },
  {
    name: 'Email',
    handle: 'hello@orbitdev.dev',
    url: 'mailto:hello@orbitdev.dev',
    desc: 'По вопросам сотрудничества',
    copy: 'hello@orbitdev.dev',
  },
  {
    name: 'Discord',
    handle: 'orbitdev',
    url: 'https://discord.gg/orbitdev',
    desc: 'Общение и комьюнити',
    copy: 'orbitdev',
  },
];
---

<BaseLayout title="Контакты — Orbit-dev">
  <section class="contacts-page section">
    <div class="container">
      <div class="contacts-page__header">
        <span class="section-label">Контакты</span>
        <h2 class="section-title">Связаться со мной</h2>
        <p class="section-subtitle">Выбери удобный способ — всегда на связи</p>
      </div>

      <div class="contacts-page__grid">
        {contacts.map((c, i) => (
          <article class="contact-card glass-card" style={`--i: ${i}`}>
            <a href={c.url} class="contact-card__main" target="_blank">
              <div class="contact-card__icon">
                {c.name === 'Telegram' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2.5L2.5 10.5l7 2.5 9-7-6 8.5 8 3z"/></svg>
                )}
                {c.name === 'GitHub' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                )}
                {c.name === 'Email' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 4l10 8 10-8"/></svg>
                )}
                {c.name === 'Discord' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.3698a19.791 19.791 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.736 19.736 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2914a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z"/></svg>
                )}
              </div>
              <div class="contact-card__info">
                <span class="contact-card__title">{c.name}</span>
                <span class="contact-card__handle">{c.handle}</span>
                <span class="contact-card__desc">{c.desc}</span>
              </div>
            </a>
            <button class="contact-card__copy" data-copy={c.copy} aria-label="Копировать {c.name}">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
            </button>
          </article>
        ))}
      </div>

      <div class="contacts-page__footer">
        <p>Или напиши мне напрямую — отвечу в течение дня</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contacts-page {
    min-height: 80vh;
    display: flex;
    align-items: center;
  }

  .contacts-page__header {
    margin-bottom: 48px;
  }

  .contacts-page__header .section-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 560px;
    line-height: 1.7;
    animation: fadeInUp 0.6s ease both 0.15s;
  }

  .contacts-page__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .contact-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0;
    gap: 0;
    overflow: hidden;
    animation: cardEnter 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(0.1s + var(--i, 0) * 0.1s);
  }

  .contact-card__main {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    flex: 1;
    min-width: 0;
  }

  .contact-card:hover {
    transform: translateY(-3px);
  }

  .contact-card:active {
    transform: translateY(0) scale(0.98);
  }

  .contact-card__icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-subtle);
    border-radius: 14px;
    flex-shrink: 0;
    color: var(--accent);
    transition: all var(--transition);
  }

  .contact-card:hover .contact-card__icon {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 0 20px var(--accent-glow);
  }

  .contact-card__info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .contact-card__title {
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .contact-card__handle {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .contact-card__desc {
    font-size: 0.78rem;
    color: var(--text-tertiary);
    margin-top: 2px;
  }

  .contact-card__copy {
    background: transparent;
    border: none;
    color: var(--text-tertiary);
    padding: 8px 16px;
    cursor: pointer;
    font-family: inherit;
    transition: all var(--transition);
    flex-shrink: 0;
    align-self: stretch;
    display: flex;
    align-items: center;
    position: relative;
  }

  .contact-card__copy:hover {
    color: var(--accent);
  }

  .contact-card__copy::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 60%;
    background: var(--border);
  }

  .contact-card__copy.copied svg {
    color: #22c55e;
    animation: pop 0.3s ease;
  }

  .contact-card__copy .tooltip {
    position: absolute;
    top: -32px;
    right: 8px;
    background: var(--bg-tertiary);
    color: var(--text-primary);
    font-size: 0.72rem;
    padding: 4px 10px;
    border-radius: 6px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translateY(4px);
    transition: all 0.2s ease;
  }

  .contact-card__copy .tooltip.show {
    opacity: 1;
    transform: translateY(0);
  }

  .contacts-page__footer {
    margin-top: 48px;
    text-align: center;
  }

  .contacts-page__footer p {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    animation: fadeInUp 0.6s ease both 0.5s;
  }

  @keyframes pop {
    0% { transform: scale(1); }
    50% { transform: scale(1.3); }
    100% { transform: scale(1); }
  }

  @media (max-width: 700px) {
    .contacts-page__grid {
      grid-template-columns: 1fr;
    }

    .contact-card__copy {
      padding: 8px 12px;
    }
  }
</style>

<script>
  document.querySelectorAll('.contact-card__copy').forEach(btn => {
    const tooltip = document.createElement('span');
    tooltip.className = 'tooltip';
    tooltip.textContent = 'Скопировано';
    btn.appendChild(tooltip);

    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      const text = btn.dataset.copy;
      try {
        await navigator.clipboard.writeText(text);
        btn.classList.add('copied');
        tooltip.classList.add('show');
        setTimeout(() => {
          btn.classList.remove('copied');
          tooltip.classList.remove('show');
        }, 1500);
      } catch {}
    });
  });
</script>
