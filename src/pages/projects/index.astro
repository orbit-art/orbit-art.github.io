---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

import zarnitsaImg from '../../assets/images/projects/zarnitsa.png';

const imgMap: Record<string, ImageMetadata> = {
  '../../assets/images/projects/zarnitsa.png': zarnitsaImg,
};

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const projectImages = await Promise.all(
  projects.map(async (p) => {
    const resolved = imgMap[p.data.image] ?? zarnitsaImg;
    return await getImage({ src: resolved, width: 720, format: 'webp', quality: 90 });
  })
);
---

<BaseLayout title="Проекты — Orbit-dev">
  <section class="projects-page section">
    <div class="container">
      <div class="projects-page__header">
        <span class="section-label t-text-reveal">Проекты</span>
        <h2 class="section-title t-text-reveal" style="--t-stagger: 1">Крупные проекты</h2>
        <p class="section-subtitle t-text-reveal" style="--t-stagger: 2">
          Серьёзные проекты с продуманной архитектурой
        </p>
      </div>

      <div class="projects-page__list">
        {projects.map((project, i) => (
          <a
            href={`/projects/${project.id.replace(/\.md$/, '')}`}
            class="project-card glass-card scroll-reveal"
            style={`--i: ${i}`}
          >
            <div class="project-card__image">
              <img src={projectImages[i].src} alt={project.data.title} width={720} height={480} loading="lazy" />
            </div>
            <div class="project-card__body">
              <h3 class="project-card__title">{project.data.title}</h3>
              <p class="project-card__desc">{project.data.description}</p>
              <div class="project-card__tags">
                {project.data.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .projects-page__header { margin-bottom: 48px; }

  .projects-page__list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .project-card {
    display: grid;
    grid-template-columns: minmax(0, 360px) 1fr;
    overflow: hidden;
    cursor: pointer;
    text-decoration: none;
  }

  .project-card__image {
    overflow: hidden;
  }

  .project-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .project-card:hover .project-card__image img { transform: scale(1.05); }

  .project-card__body {
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .project-card__title { font-size: 1.3rem; font-weight: 700; margin-bottom: 8px; }
  .project-card__desc { font-size: 0.95rem; line-height: 1.6; margin-bottom: 16px; color: var(--text-secondary); }
  .project-card__tags { display: flex; flex-wrap: wrap; gap: 6px; }

  @media (max-width: 768px) {
    .project-card {
      grid-template-columns: 1fr;
    }

    .project-card__image {
      aspect-ratio: 16 / 9;
    }

    .project-card__body {
      padding: 20px;
    }
  }
</style>
