<canvas class="cursor-canvas" aria-hidden="true"></canvas>
<div class="cursor-pen" aria-hidden="true"></div>

<style is:global>
  .cursor-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 99998;
    transition: opacity 0.3s;
  }

  .cursor-pen {
    position: fixed;
    top: 0;
    left: 0;
    width: 22px;
    height: 22px;
    pointer-events: none;
    z-index: 99999;
    will-change: transform;
    transform-origin: center center;
    transition: opacity 0.3s;
  }

  .cursor-pen::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 3px;
    height: 16px;
    background: linear-gradient(to bottom, var(--accent), transparent);
    transform: translateX(-50%) rotate(-45deg);
    transform-origin: bottom center;
    border-radius: 1px 1px 0 0;
  }

  .cursor-pen::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 50%;
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50% 50% 50% 0;
    transform: translateX(-50%) rotate(-45deg);
    box-shadow: 0 0 8px rgba(249, 115, 22, 0.6), 0 0 20px rgba(249, 115, 22, 0.3);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .cursor-pen--hover::after {
    transform: translateX(-50%) rotate(-45deg) scale(1.4);
    box-shadow: 0 0 12px rgba(249, 115, 22, 0.8), 0 0 30px rgba(249, 115, 22, 0.5), 0 0 60px rgba(249, 115, 22, 0.2);
  }

  .cursor-pen--hover::before {
    height: 20px;
    background: linear-gradient(to bottom, #fff, var(--accent));
  }

  @media (max-width: 768px) {
    .cursor-canvas, .cursor-pen { display: none !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-canvas, .cursor-pen { display: none !important; }
  }
</style>
