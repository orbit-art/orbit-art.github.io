---

---

<section class="contacts section">
  <div class="container">
    <div class="contacts__inner">
      <div class="contacts__info t-enter">
        <span class="section-label" style="color: var(--text-tertiary)">Контакты</span>
        <h2 class="section-title">Давайте обсудим проект</h2>
        <p class="section-subtitle" style="color: var(--text-secondary)">
          Открыт для предложений, сотрудничества и интересных задач.
        </p>
        <div class="contacts__links">
          <a href="mailto:hello@orbitdev.dev" class="contacts__link glass-card">
            <span class="contacts__icon">✉</span>
            <div>
              <span class="contacts__link-label" style="color: var(--text-tertiary)">Email</span>
              <span class="contacts__link-value" style="color: var(--text-primary)">hello@orbitdev.dev</span>
            </div>
          </a>
          <a href="#" class="contacts__link glass-card">
            <span class="contacts__icon">💬</span>
            <div>
              <span class="contacts__link-label" style="color: var(--text-tertiary)">Telegram</span>
              <span class="contacts__link-value" style="color: var(--text-primary)">@orbitdev</span>
            </div>
          </a>
          <a href="#" class="contacts__link glass-card">
            <span class="contacts__icon">⌨</span>
            <div>
              <span class="contacts__link-label" style="color: var(--text-tertiary)">GitHub</span>
              <span class="contacts__link-value" style="color: var(--text-primary)">/orbitdev</span>
            </div>
          </a>
        </div>
      </div>
      <form class="form glass-card t-enter" style="--t-delay: 2">
        <div class="form__row">
          <div class="form__group">
            <label class="form__label" style="color: var(--text-secondary)">Имя</label>
            <input type="text" class="form__input" placeholder="Ваше имя" required />
          </div>
          <div class="form__group">
            <label class="form__label" style="color: var(--text-secondary)">Email</label>
            <input type="email" class="form__input" placeholder="your@email.com" required />
          </div>
        </div>
        <div class="form__group">
          <label class="form__label" style="color: var(--text-secondary)">Тема</label>
          <input type="text" class="form__input" placeholder="О чём хотели поговорить?" />
        </div>
        <div class="form__group">
          <label class="form__label" style="color: var(--text-secondary)">Сообщение</label>
          <textarea class="form__textarea" rows="5" placeholder="Расскажите о вашей идее..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary form__submit">
          Отправить
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M2 8H14M14 8L9 3M14 8L9 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .contacts__inner { display: flex; flex-direction: column; gap: 64px; }
  .contacts__info { max-width: 600px; }

  .contacts__links {
    display: flex;
    gap: 16px;
    margin-top: 40px;
    flex-wrap: wrap;
  }

  .contacts__link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 24px;
    min-width: 200px;
    cursor: pointer;
  }

  .contacts__link:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  .contacts__icon {
    font-size: 1.3rem;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-subtle);
    border-radius: 10px;
  }

  .contacts__link-label { display: block; font-size: 0.8rem; font-weight: 500; }
  .contacts__link-value { display: block; font-size: 0.95rem; font-weight: 600; }

  .form { padding: 40px; max-width: 640px; }

  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .form__group { display: flex; flex-direction: column; gap: 8px; }
  .form__label { font-size: 0.85rem; font-weight: 600; }

  .form__input, .form__textarea {
    width: 100%;
    padding: 14px 16px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-primary);
    font-size: 0.9rem;
    font-family: inherit;
    transition: all var(--transition);
  }

  .form__input:focus, .form__textarea:focus {
    outline: none;
    border-color: var(--accent);
    background: rgba(249, 115, 22, 0.04);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .form__input::placeholder, .form__textarea::placeholder { color: var(--text-tertiary); }

  .form__submit { align-self: flex-start; margin-top: 8px; }

  .t-enter {
    opacity: 0;
    animation: cardEnter var(--card-enter-dur) var(--card-enter-ease) forwards;
    animation-delay: calc(var(--t-delay, 0) * 100ms);
  }

  @media (max-width: 768px) {
    .form { padding: 24px; }
    .form__row { grid-template-columns: 1fr; }
    .contacts__links { flex-direction: column; }
  }
</style>
