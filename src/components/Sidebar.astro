---

const navItems = [
  {
    href: '/',
    label: 'Главная',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><path d="M9 21V12h6v9"/></svg>`,
  },
  {
    href: '/projects',
    label: 'Проекты',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M3 12h18"/></svg>`,
  },
  {
    href: '/about',
    label: 'Обо мне',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 1 0-16 0"/></svg>`,
  },
];

const socialItems = [] as { href: string; icon: string }[];
---

<aside class="sidebar">
  <a href="/" class="sidebar__logo" aria-label="Orbitdev">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
      <path d="M12 2L2 7l10 5 10-5-10-5z" stroke="#f97316" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke="#f97316" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/>
    </svg>
  </a>

  <nav class="sidebar__links">
    {navItems.map((item) => (
      <a href={item.href} class="sidebar__link" title={item.label}>
        <span class="sidebar__icon" set:html={item.icon} />
        <span class="sidebar__label">{item.label}</span>
      </a>
    ))}
  </nav>

  {socialItems.length > 0 && (
    <div class="sidebar__social">
      {socialItems.map((item) => (
        <a href={item.href} class="sidebar__link sidebar__link--social" target="_blank">
          <span class="sidebar__icon" set:html={item.icon} />
        </a>
      ))}
    </div>
  )}
</aside>

<nav class="mobile-nav" aria-label="Навигация">
  {navItems.map((item) => (
    <a href={item.href} class="mobile-nav__link">
      <span class="mobile-nav__icon" set:html={item.icon} />
      <span class="mobile-nav__label">{item.label}</span>
    </a>
  ))}
</nav>

<style>
  .sidebar {
    position: fixed;
    top: 50%;
    left: 16px;
    transform: translateY(-50%);
    z-index: 100;
    width: 58px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-radius: 16px;
    background: rgba(17, 17, 17, 0.7);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
  }

  .sidebar__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: rgba(249, 115, 22, 0.1);
    transition: all var(--transition);
  }

  .sidebar__logo:hover {
    background: #f97316;
  }
  .sidebar__logo:hover svg path {
    stroke: #fff;
  }

  .sidebar__links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    width: 100%;
    padding: 0 4px;
  }

  .sidebar__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    width: 40px;
    padding: 5px 0 3px;
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.25);
    transition: all var(--transition);
    text-decoration: none;
  }

  .sidebar__link:hover {
    color: var(--accent);
    background: rgba(249, 115, 22, 0.08);
    transform: scale(1.1);
  }

  .sidebar__link:active {
    transform: scale(0.95);
  }

  .sidebar__link[aria-current="page"] {
    color: var(--accent);
    background: rgba(249, 115, 22, 0.1);
  }

  .sidebar__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
    transition: transform var(--bounce);
  }

  .sidebar__link:hover .sidebar__icon {
    transform: scale(1.15) rotate(-3deg);
  }

  .sidebar__label {
    font-size: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.2px;
    color: inherit;
    line-height: 1;
  }

  .sidebar__social {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    padding: 0 4px;
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 768px) {
    .sidebar { display: none; }

    .mobile-nav {
      display: flex;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 100;
      justify-content: space-around;
      align-items: center;
      padding: 8px 0 max(8px, env(safe-area-inset-bottom));
      background: rgba(10, 10, 10, 0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-top: 1px solid var(--glass-border);
    }

    .mobile-nav__link {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      padding: 6px 16px;
      border-radius: 12px;
      color: rgba(255, 255, 255, 0.35);
      text-decoration: none;
      transition: all var(--transition);
      font-size: 0.65rem;
      font-weight: 500;
      min-width: 60px;
    }

    .mobile-nav__link:active {
      transform: scale(0.92);
    }

    .mobile-nav__link[aria-current="page"],
    .mobile-nav__link:hover {
      color: var(--accent);
      background: rgba(249, 115, 22, 0.08);
    }

    .mobile-nav__icon {
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 0;
    }

    .mobile-nav__label {
      color: inherit;
      line-height: 1;
    }
  }
</style>
