---

---

<canvas class="grid-canvas"></canvas>

<script>
  let canvas, ctx;
  let mouseX = -1000;
  let mouseY = -1000;
  let time = 0;
  let animationId;

  function setup() {
    if (animationId) cancelAnimationFrame(animationId);
    canvas = document.querySelector('.grid-canvas');
    if (!canvas) return;
    ctx = canvas.getContext('2d');
    resize();
    time = 0;
    draw();
  }

  function resize() {
    if (!canvas) return;
    const dpr = window.devicePixelRatio || 1;
    const w = window.innerWidth;
    const h = window.innerHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function lineDist(px, py, x1, y1, x2, y2) {
    const dx = x2 - x1;
    const dy = y2 - y1;
    const len = dx * dx + dy * dy;
    if (len === 0) return Math.hypot(px - x1, py - y1);
    const t = Math.max(0, Math.min(1, ((px - x1) * dx + (py - y1) * dy) / len));
    return Math.hypot(px - (x1 + t * dx), py - (y1 + t * dy));
  }

  function draw() {
    const w = window.innerWidth;
    const h = window.innerHeight;

    ctx.clearRect(0, 0, w, h);

    const spacing = 64;
    const diag = Math.sqrt(w * w + h * h);
    const steps = Math.ceil(diag / spacing) + 6;

    time += 0.003;
    const offset = (time * 25) % spacing;

    const angles = [-Math.PI / 4, Math.PI / 4];

    for (let a = 0; a < 2; a++) {
      const angle = angles[a];
      const cos = Math.cos(angle);
      const sin = Math.sin(angle);

      ctx.beginPath();

      for (let i = -steps; i < steps; i++) {
        const base = i * spacing + offset;
        const x1 = base * cos - (-diag) * sin + w / 2;
        const y1 = base * sin + (-diag) * cos + h / 2;
        const x2 = base * cos - diag * sin + w / 2;
        const y2 = base * sin + diag * cos + h / 2;

        const dist = lineDist(mouseX, mouseY, x1, y1, x2, y2);

        if (dist < 200) {
          ctx.stroke();
          ctx.beginPath();
          const strength = 24 * (1 - dist / 200);
          const segs = 16;
          ctx.moveTo(x1, y1);
          for (let s = 1; s <= segs; s++) {
            const t = s / segs;
            const px = x1 + (x2 - x1) * t;
            const py = y1 + (y2 - y1) * t;
            const dx = px - mouseX;
            const dy = py - mouseY;
            const d = Math.hypot(dx, dy);
            if (d > 0) {
              ctx.lineTo(
                px + (dx / d) * strength * (1 - d / 200),
                py + (dy / d) * strength * (1 - d / 200)
              );
            } else {
              ctx.lineTo(px, py);
            }
          }
          ctx.strokeStyle = `rgba(249, 115, 22, 0.2)`;
          ctx.lineWidth = 1.2;
          ctx.stroke();
          ctx.beginPath();
        } else {
          const mx = (x1 + x2) / 2;
          const my = (y1 + y2) / 2;
          const md = Math.hypot(mx - mouseX, my - mouseY);
          const alpha = 0.035 + Math.max(0, 0.1 * (1 - md / 400));
          ctx.strokeStyle = `rgba(249, 115, 22, ${Math.min(alpha, 0.15)})`;
          ctx.lineWidth = 0.8;
          ctx.moveTo(x1, y1);
          ctx.lineTo(x2, y2);
        }
      }
      ctx.stroke();
    }

    animationId = requestAnimationFrame(draw);
  }

  function onMouseMove(e) {
    mouseX = e.clientX;
    mouseY = e.clientY;
  }

  window.addEventListener('resize', resize);
  window.addEventListener('mousemove', onMouseMove);
  setup();
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .grid-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    mask-image: radial-gradient(ellipse 60% 50% at 50% 50%, transparent 15%, #000 100%);
    -webkit-mask-image: radial-gradient(ellipse 60% 50% at 50% 50%, transparent 15%, #000 100%);
  }
</style>
