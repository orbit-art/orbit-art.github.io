---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const featured = projects.filter((p) => p.data.featured);
---

<section class="featured section">
  <div class="container">
    <div class="featured__header t-enter">
      <div>
        <span class="section-label" style="color: var(--text-tertiary)">Проекты</span>
        <h2 class="section-title">Избранные работы</h2>
      </div>
      <a href="/projects" class="btn btn-outline" style="color: var(--text-primary)">Все проекты →</a>
    </div>

    <div class="featured__grid">
      {featured.map((project, i) => (
        <a href={`/projects/${project.id.replace(/\.md$/, '')}`} class="featured__card glass-card t-enter" style={`--t-delay: ${i + 1}`}>
          <div class="featured__image">
            <Image src={project.data.image} alt={project.data.title} width={600} height={375} />
            <div class="featured__overlay">
              <span class="btn btn-primary">Подробнее</span>
            </div>
          </div>
          <div class="featured__body">
            <h3 class="featured__title" style="color: var(--text-primary)">{project.data.title}</h3>
            <p class="featured__desc" style="color: var(--text-secondary)">{project.data.description}</p>
            <div class="featured__tags">
              {project.data.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .featured__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 48px;
  }

  .featured__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 24px;
  }

  .featured__card { display: block; overflow: hidden; cursor: pointer; }

  .featured__image {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .featured__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .featured__card:hover .featured__image img { transform: scale(1.06); }

  .featured__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition);
  }

  .featured__card:hover .featured__overlay { opacity: 1; }

  .featured__body { padding: 24px; }
  .featured__title { font-size: 1.15rem; font-weight: 700; margin-bottom: 8px; }
  .featured__desc { font-size: 0.9rem; line-height: 1.6; margin-bottom: 16px; }
  .featured__tags { display: flex; flex-wrap: wrap; gap: 6px; }

  .t-enter {
    opacity: 0;
    animation: cardEnter var(--card-enter-dur) var(--card-enter-ease) forwards;
    animation-delay: calc(var(--t-delay, 0) * 100ms);
  }

  @media (max-width: 768px) {
    .featured__header { flex-direction: column; align-items: flex-start; gap: 16px; }
    .featured__grid { grid-template-columns: 1fr; }
  }
</style>
